# Display app environment variables
# See README.md for details

PHOTO_FRAME_FADE_DURATION=1.5
PHOTO_FRAME_SKIP_FRAMES=0

# Socket the display app listens on for image paths (IMG).
# Must match display_socket_path in /etc/photo-frame/config.toml.
DISPLAY_SOCKET_PATH=/run/photo-frame/photo-frame.sock

# Socket the display app listens on for control commands (CLR/SHOW/RESUME).
# Must match control_socket_path in /etc/photo-frame/config.toml.
CONTROL_SOCKET_PATH=/run/photo-frame/control.sock
