[Unit]
Description=Photo Frame DRM Display
After=multi-user.target

[Service]
Type=simple
# Runs whichever release /opt/photo-frame/current points at. A normal update
# only flips that symlink, so this unit does not change.
ExecStart=/opt/photo-frame/current/bin/photo-frame-display
EnvironmentFile=-/etc/photo-frame/display.env
Restart=on-failure
User=photo-frame
Group=video
# Owns /run/photo-frame and the sockets inside it; the manager only reads it.
RuntimeDirectory=photo-frame
StandardOutput=null
StandardError=null
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
