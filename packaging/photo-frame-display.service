[Unit]
Description=Photo Frame DRM Display
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/photo-frame-display
EnvironmentFile=-/etc/photo-frame/display.env
Restart=on-failure
User=photo-frame
Group=video
# Owns /run/photo-frame and the sockets inside it; the manager only reads it.
RuntimeDirectory=photo-frame
StandardOutput=null
StandardError=null
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
